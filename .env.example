# Optional – backend API base URL (no trailing slash)
# If not set, dev mode uses Expo debug host + EXPO_PUBLIC_API_PORT
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional – for Android emulator use host.docker.internal or your machine IP
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# Optional
# EXPO_PUBLIC_API_PORT=8000
# EXPO_PUBLIC_API_CONTRACT_ID=whoisnot-public-admin-api
# EXPO_PUBLIC_API_CONTRACT_VERSION=v1
