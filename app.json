{
  "expo": {
    "name": "whoisnot",
    "slug": "whoisnot",
    "scheme": "whoisnot",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait"
        ],
        "CFBundleAllowMixedLocalizations": true
      },
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.vladimirmanov.whoisnot",
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff",
          "defaultChannel": "default"
        }
      ],
      "expo-image",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "WhoIsNot uses the camera for player selfies and round photos in Cam Mode. Photos stay on your device.",
          "microphonePermission": "WhoIsNot uses the microphone to record sound in your Cam Mode round videos.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "WhoIsNot saves your Cam Mode round photos to your gallery when you ask it to.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      "./plugins/withCamScreenRecorder"
    ],
    "locales": {
      "en": "./locales/ios/en.json",
      "bg": "./locales/ios/bg.json",
      "fr": "./locales/ios/fr.json",
      "es": "./locales/ios/es.json"
    }
  }
}
