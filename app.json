{
  "expo": {
    "name": "whoisnot",
    "slug": "whoisnot",
    "scheme": "whoisnot",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.vladimirmanov.whoisnot"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-asset"]
  }
}
